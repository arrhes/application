{
    "name": "@comptasse/ui",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "main": "./src/index.ts",
    "module": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "import": "./src/index.ts",
            "types": "./src/index.ts"
        },
        "./components/*": "./src/components/*",
        "./utilities/*": "./src/utilities/*",
        "./styles/*": "./src/styles/*",
        "./fonts/*": "./src/fonts/*",
        "./css": {
            "import": "./styled-system/css/index.mjs",
            "types": "./styled-system/css/index.d.ts"
        },
        "./styled-system": "./styled-system/index.mjs",
        "./styled-system/*": "./styled-system/*",
        "./*": "./*"
    },
    "scripts": {
        "prepare": "panda codegen",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@hookform/resolvers": "5.7.1",
        "@pandacss/dev": "1.12.0",
        "@tabler/icons-react": "3.46.0",
        "@tanstack/react-router": "1.170.18",
        "@tanstack/react-virtual": "3.14.9",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-hook-form": "7.84.0",
        "react-imask": "7.6.1",
        "valibot": "1.4.2"
    },
    "devDependencies": {
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "typescript": "7.0.2"
    }
}
