{
    "name": "@arrhes/ui",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "main": "./src/index.ts",
    "module": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "import": "./src/index.ts",
            "types": "./src/index.ts"
        },
        "./components/*": "./src/components/*",
        "./utilities/*": "./src/utilities/*",
        "./styles/*": "./src/styles/*",
        "./fonts/*": "./src/fonts/*",
        "./css": {
            "import": "./styled-system/css/index.mjs",
            "types": "./styled-system/css/index.d.ts"
        },
        "./styled-system": "./styled-system/index.mjs",
        "./styled-system/*": "./styled-system/*",
        "./*": "./*"
    },
    "scripts": {
        "prepare": "panda codegen",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@pandacss/dev": "1.11.0",
        "@tabler/icons-react": "3.42.0",
        "@tanstack/react-router": "1.169.2",
        "@tanstack/react-virtual": "3.13.24",
        "react": "19.2.6",
        "react-dom": "19.2.6",
        "react-hook-form": "7.75.0",
        "react-imask": "7.6.1"
    },
    "devDependencies": {
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "typescript": "6.0.3"
    }
}
