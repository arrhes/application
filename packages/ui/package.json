{
    "name": "@arrhes/ui",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "main": "./src/index.ts",
    "module": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "import": "./src/index.ts",
            "types": "./src/index.ts"
        },
        "./components/*": "./src/components/*",
        "./utilities/*": "./src/utilities/*",
        "./styles/*": "./src/styles/*",
        "./fonts/*": "./src/fonts/*",
        "./css": {
            "import": "./styled-system/css/index.mjs",
            "types": "./styled-system/css/index.d.ts"
        },
        "./styled-system": "./styled-system/index.mjs",
        "./styled-system/*": "./styled-system/*",
        "./*": "./*"
    },
    "scripts": {
        "prepare": "panda codegen",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@pandacss/dev": "1.8.1",
        "@radix-ui/react-dialog": "1.1.15",
        "@radix-ui/react-popover": "1.1.15",
        "@radix-ui/react-switch": "1.2.6",
        "@tabler/icons-react": "3.35.0",
        "@tanstack/react-router": "1.139.10",
        "@tanstack/react-virtual": "3.13.12",
        "cmdk": "1.1.1",
        "react": "19.2.0",
        "react-hook-form": "7.66.1",
        "react-imask": "7.6.1"
    },
    "devDependencies": {
        "@types/react": "19.2.7",
        "typescript": "5.9.3"
    }
}
