{
    "name": "@comptasse/application-tools",
    "type": "module",
    "private": true,
    "scripts": {
        "build:metadata": "pnpm --filter @comptasse/application-metadata build",
        "generate": "pnpm run build:metadata && tsx ./src/generateMigrations.ts",
        "save-snapshot": "pnpm run build:metadata && tsx ./src/saveSnapshot.ts",
        "push": "pnpm run build:metadata && tsx ./src/push.ts",
        "pull": "pnpm drizzle-kit introspect --config=./src/drizzle.config.ts",
        "seed": "pnpm run build:metadata && tsx ./src/seed/seed.ts",
        "migration": "pnpm run build:metadata && tsx ./src/seed/migration.ts",
        "clear": "pnpm run build:metadata && tsx ./src/clearDB.ts",
        "reset": "pnpm run build:metadata && tsx ./src/clearDB.ts && pnpm run push && tsx ./src/seed/seed.ts",
        "drop": "pnpm drizzle-kit drop --config=./src/drizzle.config.ts"
    },
    "devDependencies": {
        "@types/node": "26.1.2",
        "drizzle-kit": "0.31.10",
        "tsx": "4.23.5",
        "typescript": "7.0.2"
    },
    "dependencies": {
        "@comptasse/application-metadata": "workspace:*",
        "@ngneat/falso": "8.0.2",
        "drizzle-orm": "0.45.2",
        "postgres": "3.4.9",
        "valibot": "1.4.2"
    }
}
