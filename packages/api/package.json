{
    "name": "@arrhes/application-api",
    "type": "module",
    "private": false,
    "scripts": {
        "dev": "tsx watch --conditions source ./src/server.ts",
        "build": "tsc --build",
        "start": "node ./build/server.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:unit": "vitest run ../../tests/api/unit",
        "test:integration": "vitest run ../../tests/api/integration"
    },
    "devDependencies": {
        "@types/node": "26.1.1",
        "tsx": "4.23.0",
        "typescript": "6.0.3",
        "vitest": "4.1.10"
    },
    "dependencies": {
        "@arrhes/application-metadata": "workspace:*",
        "@aws-sdk/client-s3": "3.1081.0",
        "@aws-sdk/s3-request-presigner": "3.1081.0",
        "@mollie/api-client": "4.6.0",
        "drizzle-orm": "0.45.2",
        "hono": "4.12.28",
        "postgres": "3.4.9",
        "valibot": "1.4.2"
    }
}
