{
    "name": "@arrhes/application-api",
    "type": "module",
    "private": false,
    "scripts": {
        "dev": "tsx watch --conditions source --env-file=.env ./src/server.ts",
        "build": "tsc --build",
        "start": "node --env-file=.env ./build/server.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:unit": "vitest run ../../tests/api/unit",
        "test:integration": "vitest run ../../tests/api/integration"
    },
    "devDependencies": {
        "@types/node": "25.6.0",
        "@types/nodemailer": "8.0.0",
        "tsx": "4.21.0",
        "typescript": "6.0.3",
        "vitest": "4.1.5"
    },
    "dependencies": {
        "@arrhes/application-metadata": "workspace:*",
        "@aws-sdk/client-s3": "3.1043.0",
        "@aws-sdk/s3-request-presigner": "3.1043.0",
        "@mollie/api-client": "4.5.0",
        "@tanstack/ai": "0.14.0",
        "@tanstack/ai-ollama": "0.6.10",
        "@tanstack/ai-openai": "0.8.2",
        "@valibot/to-json-schema": "1.7.0",
        "bull": "4.16.5",
        "drizzle-orm": "0.45.2",
        "hono": "4.12.18",
        "ioredis": "5.10.1",
        "nodemailer": "8.0.7",
        "openai": "6.36.0",
        "postgres": "3.4.9",
        "valibot": "1.4.0"
    }
}