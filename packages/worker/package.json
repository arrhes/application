{
    "name": "@evidensy/worker",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "tsx watch --conditions source --env-file=.env ./src/main.ts",
        "build": "tsc --build",
        "start": "node --env-file=.env ./build/main.js"
    },
    "devDependencies": {
        "@types/node": "26.1.1",
        "tsx": "4.23.0",
        "typescript": "6.0.3"
    },
    "dependencies": {
        "@arrhes/application-metadata": "workspace:*",
        "@aws-sdk/client-s3": "3.1081.0",
        "@tanstack/ai": "0.14.0",
        "@tanstack/ai-ollama": "0.6.10",
        "@valibot/to-json-schema": "1.7.1",
        "bull": "4.16.5",
        "drizzle-orm": "0.45.2",
        "ioredis": "5.11.1",
        "openai": "6.45.0",
        "postgres": "3.4.9",
        "valibot": "1.4.2"
    },
    "imports": {
        "#src/*": "./build/*"
    }
}
