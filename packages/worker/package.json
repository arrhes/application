        "@google-cloud/vertexai": "1.10.0",
        "@huggingface/inference": "4.7.0",
        "@qdrant/qdrant-js": "1.15.0",
        "@tanstack/ai": "0.9.1",
        "@tanstack/ai-ollama": "0.6.3",
        "@valibot/to-json-schema": "1.2.0",
        "bull": "4.16.5",
        "drizzle-orm": "0.44.7",
        "ioredis": "5.7.0",
        "openai": "5.12.2",
